---
export const prerender = true

import { getCollection, render } from 'astro:content'
import me from '@/data/me.json'
import SiteFooter from '@/components/ui/SiteFooter.astro'
import '@fontsource-variable/inter'
import '@/styles/global.css'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)
const title = `${post.data.title} — ${me.fullName}`
const month = post.data.date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })
const formattedDate = `${month} ${post.data.date.getUTCDate()} ${post.data.date.getUTCFullYear()}`
---

<!doctype html>
<html lang='es' data-theme='dark'>
<head>
  <meta charset='UTF-8' />
  <meta name='viewport' content='width=device-width, initial-scale=1.0' />
  <title>{title}</title>
  <meta name='description' content={post.data.description} />
  <script is:inline>
    localStorage.theme = 'dark'
    document.documentElement.dataset.theme = 'dark'
  </script>
</head>
<body style="background: #1e1e21; color: #e4e4e7; min-height: 100vh;">
  <div class="max-w-[816px] mx-auto px-6 md:px-12 py-8 md:py-12 lg:pb-24">

    <a
      href="/blog"
      class="back-link inline-flex items-center gap-2 text-sm font-medium mb-6 transition-colors duration-200"
      style="color: #d4d4d8"
    >
      ← Blog
    </a>

    <div class="sheet">

    <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-wide">
      <time style="color: #d4d4d8">{formattedDate}</time>
      <span style="color: #71717a">·</span>
      <span style="color: #d4a373">{post.data.category}</span>
    </div>
    <h1 class="mt-1 text-3xl font-bold mb-8" style="color: #ffffff">{post.data.title}</h1>

    <div class="post-content">
      <Content />
    </div>

    </div>

  </div>
  <SiteFooter />
</body>
</html>

<style>
  .back-link:hover {
    color: #d4a373 !important;
  }
  .post-content {
    color: #e4e4e7;
    line-height: 1.7;
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  .post-content :global(h2) {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .post-content :global(p) {
    margin-top: 0.75rem;
  }
  .post-content :global(a) {
    color: #d4a373;
  }
  .post-content :global(code) {
    background: #1e1e21;
    border: 1px solid #3f3f46;
    border-radius: 0.25rem;
    padding: 0.1rem 0.35rem;
    font-size: 0.875em;
  }
  .post-content :global(ul) {
    list-style: '- ';
    padding-left: 1.25rem;
    margin-top: 0.5rem;
  }
  .post-content :global(li) {
    padding-left: 0.25rem;
  }
  .post-content :global(h1) {
    color: #ffffff;
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 1.75rem;
  }
  .sheet {
    background: #27272a;
    border: 1px solid #3f3f46;
    border-radius: 0.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    padding: 2.5rem 2rem;
  }
  @media (min-width: 768px) {
    .sheet {
      padding: 3.5rem 4rem;
    }
  }
</style>
